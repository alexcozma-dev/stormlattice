# Copy to .env and fill in. .env is gitignored; never commit real keys.

# LLM provider used for NOTAM parsing and briefings (pick one and set its key)
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=

# FAA NOTAM API credentials (https://api.faa.gov)
FAA_CLIENT_ID=
FAA_CLIENT_SECRET=

# Where the live pipeline caches downloads and outputs
STORM_DATA_DIR=./data

# "live", "replay" or "simulated" — shown as a banner in the UI
STORM_MODE=replay
