# Copy to .env and fill in. .env is gitignored; never commit real keys.

# LLM provider used for NOTAM parsing and briefings: gemini (primary) or openrouter (backup).
# Only the chosen provider's key is read. LLM_MODEL is optional: leave it empty for the default in
# stormlattice/llm/client.py, or set an id of the chosen provider (OpenRouter ids look like google/...).
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# FAA NOTAM API credentials (https://api.faa.gov)
FAA_CLIENT_ID=
FAA_CLIENT_SECRET=

# Where the live pipeline caches downloads and outputs
STORM_DATA_DIR=./data

# "live", "replay" or "simulated" — shown as a banner in the UI
STORM_MODE=replay
